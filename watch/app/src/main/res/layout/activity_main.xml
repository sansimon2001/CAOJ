<?xml version="1.0" encoding="utf-8"?>
<!--
  手表一屏只做一件事：中间一个钮。
  圆形表两边的角会被裁掉，所以左右各留 26dp 的呼吸，不把文字顶到边缘。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#000000"
    android:paddingStart="26dp"
    android:paddingEnd="26dp"
    android:paddingTop="30dp"
    android:paddingBottom="22dp">

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/status_searching"
        android:textColor="#9E9E9E"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="--:--"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/btnMain"
        android:layout_width="118dp"
        android:layout_height="118dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_btn_idle"
        android:gravity="center"
        android:text="@string/btn_start"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnMark"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:minWidth="92dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/btn_mark"
        android:textColor="#E8E8E8"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/hint_ready"
        android:textColor="#5E5E5E"
        android:textSize="9sp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 深色玻璃底：中性深灰 + 极淡红柔光 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#121212" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.88"
                android:centerY="0.06"
                android:gradientRadius="520dp"
                android:startColor="#24E60012"
                android:endColor="#00E60012" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.05"
                android:centerY="0.95"
                android:gradientRadius="560dp"
                android:startColor="#18FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
